# Copy to vars/env.tfvars (git-ignored) and fill in.

project_name = "studio"
project_id   = "your-gcp-project-id"
region       = "asia-south1" # Agent Runtime sandboxes must be available in this region

# Printed by scripts/sandbox_templates.py after you build the sandbox image
sandbox_template = "projects/YOUR_PROJECT_NUMBER/locations/asia-south1/reasoningEngines/YOUR_ENGINE_ID/sandboxEnvironmentTemplates/YOUR_TEMPLATE_ID"
capture_template = "" # optional: a template with internet access enables "brand from website"

# Your public domain (Firebase Hosting fronts Cloud Run; www redirects to it)
domain = "example.com"

# Optional: emails that are always Pro with unlimited credits
owner_emails = ""

# Optional: Dodo Payments product ids (test_mode until you go live)
# dodo_environment = "test_mode"
# dodo_products    = { pro_monthly = "pdt_...", pro_annual = "pdt_...", topup = "pdt_..." }
