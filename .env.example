# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Studio
STUDIO_MODEL=gemini-3.8-flash
STUDIO_LOOK_MODEL=gemini-3.8-flash
# docker = local container on STUDIO_SANDBOX_URL; vertex = one Agent Runtime Sandbox per workspace
STUDIO_SANDBOX=docker
STUDIO_SANDBOX_URL=http://localhost:8080
STUDIO_SANDBOX_LOCATION=asia-south1
STUDIO_SANDBOX_TEMPLATE=projects/YOUR_PROJECT_NUMBER/locations/asia-south1/reasoningEngines/YOUR_ENGINE_ID/sandboxEnvironmentTemplates/YOUR_TEMPLATE_ID
STUDIO_SANDBOX_CALLER_SA=studio-sandbox-caller@YOUR_PROJECT_ID.iam.gserviceaccount.com
# Sessions + usage ledger (local sqlite; Cloud SQL Postgres when deployed)
SESSION_SERVICE_URI=sqlite+aiosqlite:///./.data/sessions.db
STUDIO_DB_URL=sqlite+aiosqlite:///./.data/studio.db
# off = local dev (every request is user "dev"); firebase = production sign-in
STUDIO_AUTH=off
STUDIO_ARTIFACT_DIR=.data/artifacts
